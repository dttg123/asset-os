{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "scripts/**/*.mjs",
    "src/**/*.ts",
    "*.ts"
  ]
}
